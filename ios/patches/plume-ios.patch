+    static bool IsFramebufferAttachment(const MetalAttachment &attachment, const RenderTexture *texture) {
+        if (attachment.format == RenderFormat::UNKNOWN) {
+            return false;
+        }
+
+        if (static_cast<const void *>(attachment.texture) == static_cast<const void *>(texture)) {
+            return true;
+        }
+
+        if (attachment.textureView != nullptr && static_cast<const void *>(attachment.textureView->parentTexture) == static_cast<const void *>(texture)) {
+            return true;
+        }
+
+        return attachment.getTexture() == static_cast<const ExtendedRenderTexture *>(texture)->getTexture();
+    }
+
+    static bool IsFramebufferAttachment(const MetalFramebuffer *framebuffer, const RenderTexture *texture) {
+        for (const MetalAttachment &attachment : framebuffer->colorAttachments) {
+            if (IsFramebufferAttachment(attachment, texture)) {
+                return true;
+            }
+        }
+
+        return IsFramebufferAttachment(framebuffer->depthAttachment, texture);
+    }
+}
